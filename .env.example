# Thin server settings (docs/server.md). Copy to .env.local (git-ignored) for npm run dev; set them in Vercel for a deploy.
# Never commit a real key.
MODEL_API_KEY=
# Only to point the server at a local mock of the API.
META_API_BASE_URL=
# 1 switches every /api route off (presets only).
PHYSICS_TWIN_API_OFF=
# Calls that may reach the Model API per UTC day, all routes together (default 400).
PHYSICS_TWIN_DAILY_CAP=
